# Database
# Base MongoDB connection URI; the application appends the "quickblog" database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>

# Admin authentication
# Credentials accepted by POST /api/admin/login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Long, random secret used to sign JSON Web Tokens.
JWT_SECRET=replace-with-a-long-random-secret

# ImageKit
# Private API key used to upload and delete blog images.
IMAGEKIT_PRIVATE_KEY=private_<your-imagekit-private-key>

# URL endpoint used to generate optimized image URLs.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-imagekit-id>

# Server
# HTTP server port.
PORT=3000
